<?xml version="1.0" encoding="utf-8"?>
<!-- the copy downloaded from honggame.store updates itself (the Google Play copy is updated by Google Play) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <application>
        <receiver android:name=".UpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="store.honggame.hongsub.UPDATE_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
